# Copie para .env e ajuste. scripts/init.ps1 (Windows) ou scripts/init.sh (Linux/macOS)
# fazem isso automaticamente e geram chaves/senhas aleatórias.

# Pasta raiz de mídia e downloads no host. Será criada a estrutura:
#   <DATA_ROOT>/torrents/{complete,incomplete}
#   <DATA_ROOT>/media/{movies,tv}
# Windows: use barras normais, ex.: D:/Jellyfin/data   | Linux: /mnt/data
DATA_ROOT=D:/Jellyfin/data

# Endereço pelo qual os clientes acessam o servidor (IP da máquina na rede ou localhost)
SERVER_HOST=localhost

TZ=America/Sao_Paulo
PUID=1000
PGID=1000

# Usuário/senha únicos usados em Jellyfin, Jellyseerr (admin), qBittorrent e login dos *arr
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Chaves de API (32 caracteres hex). Geradas pelo script init.
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# Idioma de metadados do Jellyfin e idiomas de legenda do Bazarr (códigos do Bazarr: pb = português do Brasil, pt, en, es...)
METADATA_LANGUAGE=pt-BR
METADATA_COUNTRY=BR
SUBTITLE_LANGUAGES=pb,en

# Legenda padrão dos usuários do Jellyfin (código ISO 639-2: por = português) e modo
# (Always = sempre liga, Default, Smart = só quando o áudio é de outro idioma, OnlyForced, None).
# Só é aplicada a usuários que ainda não escolheram uma preferência.
JELLYFIN_SUBTITLE_LANGUAGE=por
JELLYFIN_SUBTITLE_MODE=Always

# Intervalo da varredura automática da biblioteca do Jellyfin, em horas (padrão do Jellyfin: 12)
JELLYFIN_SCAN_INTERVAL_HOURS=1

# Opcional: conta em opensubtitles.com para o Bazarr (deixe vazio para pular).
# Também pode vir de variáveis de ambiente com o mesmo nome ao rodar scripts/init.* ou proxmox/install-*.sh
# Recomendado para legendas pt-BR: os provedores gratuitos sem conta têm pouco conteúdo.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Indexers públicos adicionados ao Prowlarr (nomes de definição do Prowlarr, separados por vírgula).
# Deixe vazio (PROWLARR_INDEXERS=) para não adicionar nenhum.
PROWLARR_INDEXERS=1337x,thepiratebay,Knaben,limetorrents,uindex,yts,eztv,nyaasi
# Indexers que sempre passam pelo FlareSolverr (proteção Cloudflare)
FLARESOLVERR_INDEXERS=1337x,uindex,eztv
